#!/bin/sh
# Local fallback launcher for this classroom project.
# Uses the Gradle installed on the machine, so './gradlew bootRun' works in the same way for this project.
if ! command -v gradle >/dev/null 2>&1; then
  echo "ERROR: Gradle is not installed or not on PATH." >&2
  echo "Install Gradle first (e.g. brew install gradle) and run again." >&2
  exit 1
fi
exec gradle "$@"
